{
  "name": "nevma-style",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.23.4" },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "packageExtensions": {
      "@napi-rs/wasm-runtime": {
        "dependencies": {
          "@emnapi/core": "^1.7.1",
          "@emnapi/runtime": "^1.7.1"
        }
      }
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter studio dev",
    "build": "pnpm --filter web build",
    "check": "pnpm --filter web check && node scripts/check-placeholders.mjs && node scripts/check-js-budget.mjs",
    "lighthouse": "node scripts/lighthouse-report.mjs",
    "test": "pnpm --filter web test",
    "test:fidelity": "pnpm --filter web test:fidelity",
    "test:fidelity:self": "pnpm --filter web test:fidelity:self"
  }
}
