# ---- site
PUBLIC_SITE_URL=http://localhost:4321
COMMERCE_ENABLED=true             # shop live; false = emergency switch (no Shopify calls, notify-only)
COMMERCE_MOCK=1                   # local + fidelity tests only; refused in production
PUBLIC_FIXED_NOW=2026-10-23T13:00:00Z   # mock mode only

# ---- Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=               # Editor robot token: form submissions, customer wishlist/preferences, alert log
SANITY_REVALIDATE_SECRET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# ---- Shopify (Headless channel)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_SHOP_ID=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ADMIN_TOKEN=              # scripts only

# ---- sessions, email, bot protection, cron
SESSION_SECRET=
RESEND_API_KEY=
MAIL_FROM="NEVMA Style <style@[domain]>"
CLIENT_CARE_TO=
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare test key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CRON_SECRET=
