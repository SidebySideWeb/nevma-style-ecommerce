---
import { headerCounts } from '../../lib/chrome';
import { ui } from '../../content/ui';

const cookie = Astro.request.headers.get('cookie');
const { wishlist } = await headerCounts(cookie);
const n = wishlist;
---

<a href="/wishlist" class="s-ib" aria-label={ui.chrome.wishlistAria(n)}>
  <svg
    width="19"
    height="19"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linejoin="round"
    aria-hidden="true"
    ><path
      d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"
    ></path></svg
  >
</a>
