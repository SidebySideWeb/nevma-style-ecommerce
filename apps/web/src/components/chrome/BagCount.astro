---
import { headerCounts } from '../../lib/chrome';
import { ui } from '../../content/ui';

const cookie = Astro.request.headers.get('cookie');
const { bag } = await headerCounts(cookie);
const n = bag;
const showCount = n > 0;
---

<a href="/bag" class="s-ib" aria-label={ui.chrome.bagAria(n)}>
  <svg
    width="19"
    height="19"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linejoin="round"
    aria-hidden="true"
    ><path d="M5 8h14l-1 12H6z"></path><path
      d="M9 8V6.5a3 3 0 0 1 6 0V8"
      stroke-linecap="round"></path></svg
  >
  {
    showCount ? (
      <span class="s-count" aria-hidden="true">
        {n}
      </span>
    ) : null
  }
</a>
