---
import type { ChromeData } from '../../lib/chrome';

interface Props {
  announcement: NonNullable<ChromeData['announcement']>;
}

const { announcement: a } = Astro.props;
---

<div class="s-dark" style="background: #000000; color: #F5F5F7" data-block="announcement">
  <div
    class="s-wrap"
    style="min-height: 40px; display: flex; align-items: center; justify-content: center; gap: 10px 18px; flex-wrap: wrap; padding-block: 8px; text-align: center"
  >
    <span class="s-f" style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase"
      ><span style="color: #F0E81C">{a.code} · {a.name}</span>{a.textRest}</span
    >
    <a
      href={a.href}
      class="s-f s-lnk"
      style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase">{a.linkLabel}</a
    >
  </div>
</div>
