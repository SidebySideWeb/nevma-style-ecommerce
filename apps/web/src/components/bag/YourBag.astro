---
import type { BagPageData, BagLineView } from '../../lib/bag';
import EditionPips from '../ui/EditionPips.astro';
import { ui } from '../../content/ui';
import { resolvePhoto, slots } from '../../lib/sanity/image';

interface Props {
  bag: BagPageData;
}

const { bag: b } = Astro.props;

function src(line: BagLineView): string | null {
  if (!line.hasImage || !line.photo) return null;
  return resolvePhoto(line.photo, slots.card)?.src || null;
}
---

<div
  class="s-wrap"
  style="padding-block: 64px 104px; display: flex; flex-direction: column; gap: 40px"
  data-block="your-bag"
>
  <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap">
    <h1 class="s-disp" style="margin: 0; font-size: clamp(30px, 3.4vw, 48px); letter-spacing: 0.24em"
      >{ui.bag.yourBag}</h1
    >
    <p style="margin: 0; font-size: 15px; color: #3E3B35">{b.countLabel}</p>
  </div>

  {
    b.notice ? (
      <div
        role="alert"
        style="display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border: 1px solid #0B0B0C; border-radius: 6px; background: #F5F2EC"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
          style="flex: 0 0 auto; margin-top: 3px"
          ><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5.5M12 16.5v.01"></path></svg
        >
        <div style="display: flex; flex-direction: column; gap: 4px"
          ><strong>{b.notice.title}</strong
          ><span style="font-size: 15px; color: #3E3B35">{b.notice.text}</span></div
        >
      </div>
    ) : null
  }

  {
    b.empty ? (
      <div
        style="display: flex; flex-direction: column; align-items: flex-start; gap: 22px; padding: 56px 0; border-top: 1px solid #CFC7B8"
      >
        <p class="s-name" style="margin: 0; font-size: 15px">
          {b.emptyTitle}
        </p>
        <p style="margin: 0; max-width: 48ch; color: #3E3B35">{b.emptyText}</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap"
          ><a href={b.emptyPrimaryHref} class="s-btn s-btn-p">{b.emptyPrimaryLabel}</a
          ><a href={b.emptySecondaryHref} class="s-btn s-btn-o">{b.emptySecondaryLabel}</a></div
        >
      </div>
    ) : (
      <div class="s-bag">
        <div class="s-items">
          <ul style="list-style: none; margin: 0; padding: 0; border-bottom: 1px solid #CFC7B8">
            {b.lines.map((line) => {
              const img = src(line);
              return (
                <li class="s-line" style={`opacity: ${line.opacity}`}>
                  <a
                    href={line.href}
                    style={`display: block; width: 100%; aspect-ratio: 4 / 5; border-radius: 2px; overflow: clip; background: ${line.toneBg}`}
                  >
                    {img ? (
                      <img
                        src={img}
                        alt={line.alt}
                        style={`width: 100%; height: 100%; object-fit: cover; object-position: ${line.objectPosition}; display: block; filter: ${line.imgFilter}`}
                      />
                    ) : null}
                  </a>
                  <div style="display: flex; flex-direction: column; gap: 6px">
                    <a href={line.href} class="s-name" style="font-size: 13.5px; text-decoration: none">
                      {line.title}
                    </a>
                    <span style="font-size: 14.5px; color: #3E3B35">{line.meta}</span>
                    <span style="display: flex; align-items: center; gap: 10px; margin-top: 6px">
                      <EditionPips
                        filled={line.edition.meter.filled}
                        total={line.edition.meter.total}
                        dashed={line.edition.meter.dashed}
                      />
                      <span style="font-size: 14px">{line.stockLine}</span>
                    </span>
                    <span style="display: flex; gap: 20px; margin-top: 10px">
                      <form method="post" action="/api/cart" style="display: inline; margin: 0">
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="lineId" value={line.id} />
                        <button type="submit" class="s-txt">
                          {ui.bag.remove}
                        </button>
                      </form>
                      <form method="post" action="/api/cart" style="display: inline; margin: 0">
                        <input type="hidden" name="action" value="move-to-wishlist" />
                        <input type="hidden" name="lineId" value={line.id} />
                        <input type="hidden" name="handle" value={line.handle} />
                        <button type="submit" class="s-txt" style="display: inline-flex; align-items: center">
                          {ui.bag.moveToWishlist}
                        </button>
                      </form>
                    </span>
                  </div>
                  <span
                    class="s-lp s-price"
                    style={`font-size: 16px; text-decoration: ${line.priceDecoration}`}
                  >
                    {line.priceLabel}
                  </span>
                </li>
              );
            })}
          </ul>
          <p
            style="margin: 20px 0 0; display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; color: #3E3B35"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
              style="flex: 0 0 auto; margin-top: 3px"
              ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg
            >
            {b.notHeldNote}
          </p>
        </div>

        <aside
          class="s-sum"
          aria-labelledby="sum-title"
          style="background: #F5F2EC; border: 1px solid #CFC7B8; padding: 28px; box-sizing: border-box; display: flex; flex-direction: column; gap: 18px"
        >
          <h2 id="sum-title" class="s-eb" style="color: #0B0B0C">
            {ui.bag.summary}
          </h2>
          <dl style="margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15.5px">
            <div style="display: flex; justify-content: space-between"
              ><dt>{ui.bag.subtotal}</dt><dd class="s-price" style="margin: 0">{b.subtotalLabel}</dd></div
            >
            <div style="display: flex; justify-content: space-between"
              ><dt>{ui.bag.delivery}</dt><dd style="margin: 0; color: #3E3B35">{ui.bag.atCheckout}</dd></div
            >
            <div
              style="display: flex; justify-content: space-between; padding-top: 14px; border-top: 1px solid #CFC7B8; font-weight: 700"
              ><dt>{ui.bag.estimatedTotal}</dt><dd class="s-price" style="margin: 0">{b.totalLabel}</dd></div
            >
          </dl>
          <p style="margin: 0; font-size: 13.5px; color: #615D55">{b.dutiesNote}</p>
          <a href={b.checkoutHref} class="s-btn s-btn-p" style="width: 100%">{ui.bag.checkoutSecurely}</a>
          <p style="margin: 0; font-size: 13.5px; color: #3E3B35; text-align: center">{b.checkoutNote}</p>
          <p
            style="margin: 0; padding-top: 14px; border-top: 1px solid #CFC7B8; font-size: 14px; color: #3E3B35"
          >
            {ui.bag.haveAnAccount}{' '}
            <a href="/account/sign-in">{ui.bag.signIn}</a>
            {' '}
            {ui.bag.toUseSavedAddress}
          </p>
        </aside>
      </div>
    )
  }
</div>
