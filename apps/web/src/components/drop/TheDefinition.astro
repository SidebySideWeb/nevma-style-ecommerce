---
import type { DropPageData } from '../../lib/drop';
import { ui } from '../../content/ui';
import Photo from '../ui/Photo.astro';

interface Props {
  definition: NonNullable<DropPageData['definition']>;
}

const { definition: d } = Astro.props;
---

<section
  aria-label={ui.drop.definitionAria}
  class="s-dark"
  style="position: relative; background: #000000; color: #F5F5F7; overflow: clip"
  data-block="the-definition"
>
  {
    d.photo ? (
      <Photo
        photo={d.photo}
        loading="lazy"
        alt=""
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; display: block"
      />
    ) : (
      <img
        src="/images/ribbon-glow.jpg"
        alt=""
        loading="lazy"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; display: block"
      />
    )
  }
  <div
    class="s-wrap"
    style="position: relative; min-height: 460px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 22px; padding-block: 96px"
  >
    <p style="margin: 0; display: flex; align-items: baseline; gap: 14px"
      ><span style="font-size: clamp(40px, 5vw, 72px); font-weight: 700; letter-spacing: -0.01em"
        >{d.word}</span
      ><span style="color: #A8A8B4; font-style: italic; font-size: 20px">{d.pos}</span></p
    >
    <span class="s-rule" aria-hidden="true" style="width: 120px"></span>
    <p
      style="margin: 0; max-width: 34ch; font-size: clamp(19px, 1.8vw, 24px); color: #D2D2DA"
      >{d.meaning}</p
    >
  </div>
</section>
