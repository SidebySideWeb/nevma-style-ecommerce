---
interface Props {
  filled: number;
  total?: number;
  /** Yellow pips on dark signal teasers (.s-y parent). */
  class?: string;
  /** Piece buy-box: dashed border for upcoming. */
  dashed?: boolean;
  /** When set (e.g. product 11px), applied with solid/dashed border-style. */
  pipSize?: string;
}

const {
  filled,
  total = 5,
  class: className,
  dashed = false,
  pipSize,
} = Astro.props;
const n = Math.max(0, Math.min(total, filled));
const style = pipSize
  ? `${pipSize}; border-style: ${dashed ? 'dashed' : 'solid'}`
  : dashed
    ? 'border-style: dashed'
    : undefined;
---

<span class:list={['s-ed', className]} aria-hidden="true">
  {
    Array.from({ length: total }, (_, i) => (
      <span class:list={['s-pip', { on: i < n }]} style={style} />
    ))
  }
</span>
