---
import type { HomePageData } from '../../lib/home';
import Photo from '../ui/Photo.astro';

interface Props {
  story: HomePageData['story'];
}

const { story: s } = Astro.props;
---

<section
  aria-labelledby="story-title"
  style="border-bottom: 1px solid #CFC7B8"
  data-block="story-teaser"
>
  <div
    class="s-wrap s-sec"
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: 44px 80px; align-items: center"
  >
    <a
      href="/story"
      class="s-card"
      style="display: block; overflow: clip; border-radius: 4px; aspect-ratio: 5 / 4"
      ><Photo
        photo={s.photo}
        slot="story"
        loading="lazy"
        style="width: 100%; height: 100%; object-fit: cover; display: block"
      /></a
    >
    <div style="display: flex; flex-direction: column; gap: 22px">
      <p class="s-eb">{s.eyebrow}</p>
      <h2
        id="story-title"
        class="s-disp"
        style="margin: 0; font-size: clamp(26px, 2.6vw, 38px); letter-spacing: 0.18em; line-height: 1.4"
        >{s.title}</h2
      >
      <p style="margin: 0; max-width: 46ch; color: #3E3B35">{s.text}</p>
      <a href="/story" class="s-eb s-ul" style="color: #0B0B0C; align-self: flex-start"
        >{s.linkLabel}</a
      >
    </div>
  </div>
</section>
