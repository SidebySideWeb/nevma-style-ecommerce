---
import type { HomePageData } from '../../lib/home';
import Photo from '../ui/Photo.astro';
import EditionPips from '../ui/EditionPips.astro';
import PieceTag from '../commerce/PieceTag.astro';
import PiecePrice from '../commerce/PiecePrice.astro';
import PieceMeter from '../commerce/PieceMeter.astro';

interface Props {
  pieces: HomePageData['pieces'];
  opensAt?: string | null;
}

const { pieces: p, opensAt } = Astro.props;
---

<section aria-labelledby="pieces-title" data-block="the-pieces">
  <div class="s-wrap s-sec" style="display: flex; flex-direction: column; gap: 48px">
    <div
      style="display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap"
    >
      <div style="display: flex; flex-direction: column; gap: 14px"
        ><p class="s-eb">{p.eyebrow}</p><h2 id="pieces-title" class="s-h2 s-rv">{p.title}</h2></div
      >
      <a href={p.linkHref} class="s-eb s-ul" style="color: #0B0B0C">{p.linkLabel}</a>
    </div>
    <ul class="s-trio s-stg" style="list-style: none; margin: 0; padding: 0">
      {
        p.cards.map((card) => (
          <li>
            <a
              href={card.href}
              class="s-card"
              aria-label={card.ariaLabel}
              style="display: flex; flex-direction: column; gap: 18px; text-decoration: none"
            >
              <span
                style={`position: relative; display: block; aspect-ratio: 4 / 5; overflow: clip; border-radius: 4px; background: ${card.toneBg}`}
              >
                <Photo
                  photo={card.photo}
                  loading="lazy"
                  alt=""
                  style={`width: 100%; height: 100%; object-fit: cover; display: block; filter: ${card.filter}`}
                />
                <PieceTag
                  server:defer
                  handle={card.handle}
                  opensAt={opensAt}
                  fallbackTag={card.edition.cardTag}
                  style={card.tagStyle}
                >
                  <span class="s-tag" style={card.tagStyle} slot="fallback">
                    {card.edition.cardTag}
                  </span>
                </PieceTag>
              </span>
              <span
                style="display: flex; justify-content: space-between; align-items: baseline; gap: 16px"
              >
                <span class="s-name" style="font-size: 13.5px">
                  {card.title}
                </span>
                <PiecePrice server:defer handle={card.handle} fallbackPrice={card.price}>
                  <span class="s-price" style="font-size: 15px" slot="fallback">
                    {card.price}
                  </span>
                </PiecePrice>
              </span>
              <PieceMeter
                server:defer
                handle={card.handle}
                opensAt={opensAt}
                fallbackFilled={card.edition.meter.filled}
                fallbackLine={card.edition.meterLine}
              >
                <span style="display: flex; align-items: center; gap: 12px" slot="fallback">
                  <EditionPips
                    filled={card.edition.meter.filled}
                    total={card.edition.meter.total}
                  />
                  <span style="font-size: 14.5px; color: #3E3B35">{card.edition.meterLine}</span>
                </span>
              </PieceMeter>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
