---
import type { CarePageData } from '../../lib/care';
import { ui } from '../../content/ui';
import { serverEnv } from '../../lib/server/env';

interface Props {
  page: CarePageData;
}

const { page: p } = Astro.props;
const turnstileSiteKey = serverEnv('PUBLIC_TURNSTILE_SITE_KEY');
const careNav = p.nav.filter((n) => n.group === 'care');
const legalNav = p.nav.filter((n) => n.group === 'legal');

const chevron = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>`;
---

<div
  class="s-wrap"
  style="padding-block: 64px 104px; display: flex; flex-direction: column; gap: 44px"
  data-block="care"
>
  <div style="display: flex; flex-direction: column; gap: 12px"
    ><p class="s-eb">{p.eyebrow}</p><h1
      class="s-disp"
      style="margin: 0; font-size: clamp(30px, 3.4vw, 48px); letter-spacing: 0.22em">{p.title}</h1
    ></div
  >
  <div class="s-acct">
    <nav class="s-side" aria-label={ui.care.navLabel}>
      <div class="s-snav">
        <p class="s-eb s-grp" style="font-size: 10.5px; padding-bottom: 10px">{ui.care.clientCare}</p>
        {
          careNav.map((item) => (
            <button
              type="button"
              class="s-sl"
              aria-current={item.current ? 'page' : 'false'}
              data-href={item.href}
            >
              {item.label}
            </button>
          ))
        }
        <p class="s-eb s-grp" style="font-size: 10.5px; padding: 28px 0 10px">{ui.care.legal}</p>
        {
          legalNav.map((item) => (
            <button
              type="button"
              class="s-sl"
              aria-current={item.current ? 'page' : 'false'}
              data-href={item.href}
            >
              {item.label}
            </button>
          ))
        }
      </div>
    </nav>

    <article class="s-body s-prose" aria-labelledby="doc-title">
      <h2 id="doc-title" class="s-h2" style="margin-bottom: 12px">{p.docTitle}</h2>
      {p.meta ? <p style="font-size: 14px; color: #615D55">{p.meta}</p> : null}

      {
        p.kind === 'prose' ? (
          <div set:html={p.bodyHtml} />
        ) : null
      }

      {
        p.kind === 'faq' ? (
          <div style="border-bottom: 1px solid #CFC7B8">
            {p.faq.map((item) => (
              <details class="s-acc" style="border-top: 1px solid #CFC7B8">
                <summary set:html={`${item.q} ${chevron}`} />
                <p style="margin: 0 0 22px">{item.a}</p>
              </details>
            ))}
          </div>
        ) : null
      }

      {
        p.kind === 'contact' && p.contact ? (
          <div>
            <p>{p.contact.intro}</p>
            {p.contact.sent ? (
              <p
                role="status"
                style="margin-top: 24px; padding: 18px 20px; border: 1px solid #0B0B0C; border-radius: 6px; color: #0B0B0C"
              >
                {p.contact.sentMessage}
              </p>
            ) : (
              <form
                method="post"
                action="/api/contact"
                style="display: flex; flex-direction: column; gap: 20px; margin-top: 24px"
                data-contact-form
              >
                <input type="hidden" name="topic" value={p.contact.selectedTopic} data-topic-input />
                {p.contact.reference ? (
                  <input type="hidden" name="reference" value={p.contact.reference} />
                ) : null}
                <fieldset style="border: 0; margin: 0; padding: 0">
                  <legend class="s-lbl">{ui.care.whatAbout}</legend>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap">
                    {p.contact.topics.map((topic) => (
                      <button
                        type="button"
                        class="s-chip"
                        aria-pressed={topic === p.contact!.selectedTopic ? 'true' : 'false'}
                        data-topic={topic}
                      >
                        {topic}
                      </button>
                    ))}
                  </div>
                </fieldset>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px">
                  <div>
                    <label for="ct-name" class="s-lbl">
                      Name
                    </label>
                    <input id="ct-name" name="name" class="s-in" autocomplete="name" required />
                  </div>
                  <div>
                    <label for="ct-email" class="s-lbl">
                      {ui.care.email}
                    </label>
                    <input
                      id="ct-email"
                      name="email"
                      class="s-in"
                      type="email"
                      autocomplete="email"
                      required
                    />
                  </div>
                </div>
                <div>
                  <label for="ct-order" class="s-lbl">{ui.care.orderNumberOptional}</label>
                  <input
                    id="ct-order"
                    name="orderNumber"
                    class="s-in"
                    placeholder={ui.care.orderPlaceholder}
                  />
                </div>
                <div>
                  <label for="ct-msg" class="s-lbl">{ui.care.message}</label>
                  <textarea id="ct-msg" name="message" class="s-in" required />
                </div>
                <input
                  type="text"
                  name="company"
                  class="s-vh"
                  tabindex="-1"
                  autocomplete="off"
                  aria-hidden="true"
                  style="background: transparent; border: 0; color: transparent"
                />
                {
                  turnstileSiteKey ? (
                    <div
                      class="cf-turnstile"
                      data-sitekey={turnstileSiteKey}
                      data-size="invisible"
                      style="display: none"
                    />
                  ) : null
                }
                <button type="submit" class="s-btn s-btn-p" style="align-self: flex-start">
                  {ui.care.send}
                </button>
                <p style="margin: 0; font-size: 13px; color: #615D55">{p.contact.privacyNote}</p>
              </form>
            )}
            <h3>Studio</h3>
            <p>{p.contact.studioLine}</p>
          </div>
        ) : null
      }
    </article>
  </div>
</div>

<script>
  import '../../scripts/care.ts';
</script>
