---
import { ui } from '../../content/ui';

/** Hidden until add-to-bag; piece.ts fills line fields and opens. */
---

<button
  type="button"
  class="s-shade"
  aria-label={ui.product.closeBag}
  data-block="bag-scrim"
  data-bag-scrim
  hidden
></button>
<aside
  class="s-drw s-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drw-title"
  data-block="bag-drawer"
  data-bag-drawer
  hidden
  style="display: none"
>
  <div
    style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #CFC7B8"
  >
    <h2 id="drw-title" class="s-eb" style="color: #0B0B0C">{ui.bagDrawer.added}</h2>
    <button type="button" class="s-ib" aria-label={ui.bagDrawer.close} data-bag-close>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
        ><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
  </div>
  <div
    style="flex: 1 1 auto; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 22px"
  >
    <div style="display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 18px">
      <img
        data-bag-img
        src=""
        alt=""
        style="width: 96px; height: 120px; object-fit: cover; border-radius: 2px; display: block; background: #000000"
      />
      <div style="display: flex; flex-direction: column; gap: 4px">
        <span class="s-name" style="font-size: 12.5px" data-bag-title></span>
        <span style="font-size: 14px; color: #3E3B35" data-bag-meta></span>
        <span class="s-price" style="font-size: 15px" data-bag-price></span>
      </div>
    </div>
    <p
      style="margin: 0; padding: 14px 16px; background: #ECE7DE; border-radius: 6px; font-size: 14px; color: #3E3B35"
      data-bag-note
    >
    </p>
    <div
      style="display: flex; justify-content: space-between; padding-top: 14px; border-top: 1px solid #CFC7B8"
    >
      <span>{ui.bag.subtotal}</span>
      <span class="s-price" data-bag-subtotal></span>
    </div>
    <p style="margin: 0; font-size: 13.5px; color: #615D55"
      >Delivery and taxes are worked out at checkout.</p
    >
  </div>
  <div
    style="padding: 20px 24px 28px; display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #CFC7B8"
  >
    <a href="#" class="s-btn s-btn-p" style="width: 100%" data-bag-checkout>{ui.bag.checkout}</a>
    <a href="/bag" class="s-btn s-btn-o" style="width: 100%">{ui.bag.viewBag}</a>
  </div>
</aside>
