---
import type { SignInPageData } from '../../lib/account/load';

interface Props {
  page: SignInPageData;
}

const { page } = Astro.props;
const last = page.benefits.length - 1;
---

<aside
  class="s-perk s-dark"
  aria-label="Why have an account"
  style="position: relative; background: #000000; color: #F5F5F7; overflow: clip"
  data-block="why-have-an-account"
>
  <img
    src={page.benefitsPhotoSrc}
    alt=""
    style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.4; display: block"
  />
  <div
    style="position: relative; height: 100%; box-sizing: border-box; padding: 64px 48px; display: flex; flex-direction: column; justify-content: flex-end; gap: 22px"
  >
    <p class="s-eb" style="color: #F0E81C">{page.benefitsTitle}</p>
    <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">
      {
        page.benefits.map((b, i) => (
          <li
            style={`padding: 16px 0; border-${i === last ? 'block' : 'top'}: 1px solid #34343C; display: flex; flex-direction: column; gap: 2px`}
          >
            <span class="s-name" style="font-size: 12.5px">
              {b.title}
            </span>
            <span style="font-size: 15px; color: #D2D2DA">{b.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
