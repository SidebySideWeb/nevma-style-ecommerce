---
import type { SignInPageData } from '../../lib/account/load';
import { ui } from '../../content/ui';

interface Props {
  page: SignInPageData;
  next?: string;
}

const { page, next = '/account' } = Astro.props;
const create = page.mode === 'create';
---

<div class="s-form" data-block="auth">
  <div style="width: 100%; max-width: 440px; display: flex; flex-direction: column; gap: 28px">
    <div style="display: flex; flex-direction: column; gap: 28px">
      <h1 class="s-disp" style="margin: 0; font-size: clamp(26px, 2.6vw, 36px); letter-spacing: 0.22em"
        >{create ? ui.signIn.createAccount : ui.signIn.signIn}</h1
      >
      <div role="tablist" aria-label="Account" style="display: flex">
        <button
          type="button"
          role="tab"
          class="s-tab"
          aria-selected={create ? 'false' : 'true'}
          data-href="/account/sign-in"
          >{ui.signIn.signIn}</button
        >
        <button
          type="button"
          role="tab"
          class="s-tab"
          aria-selected={create ? 'true' : 'false'}
          data-href="/account/sign-in?mode=create"
          >{ui.signIn.createAccount}</button
        >
      </div>
      <form
        method="post"
        action="/api/account/login"
        style="display: flex; flex-direction: column; gap: 18px"
      >
        <input type="hidden" name="mode" value={create ? 'create' : 'sign-in'} />
        <input type="hidden" name="next" value={next} />
        {
          create ? (
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px">
              <div>
                <label for="r-fn" class="s-lbl">
                  {ui.signIn.firstName}
                </label>
                <input id="r-fn" name="firstName" class="s-in" autocomplete="given-name" />
              </div>
              <div>
                <label for="r-ln" class="s-lbl">
                  {ui.signIn.lastName}
                </label>
                <input id="r-ln" name="lastName" class="s-in" autocomplete="family-name" />
              </div>
            </div>
          ) : null
        }
        <div>
          <label for="a-email" class="s-lbl">{ui.signIn.email}</label>
          <input
            id="a-email"
            name="email"
            class="s-in"
            type="email"
            autocomplete="email"
            value={page.emailDefault}
            required
          />
        </div>
        {
          create ? (
            <fieldset style="border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px">
              <legend class="s-vh">Emails</legend>
              <label style="display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px">
                <input
                  type="checkbox"
                  name="dropAlerts"
                  checked
                  style="width: 18px; height: 18px; margin: 3px 0 0; accent-color: #0B0B0C"
                />
                Email me when a drop opens
              </label>
              <label style="display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px">
                <input
                  type="checkbox"
                  name="letter"
                  style="width: 18px; height: 18px; margin: 3px 0 0; accent-color: #0B0B0C"
                />
                Send me the NEVMA Style letter, about once a month
              </label>
            </fieldset>
          ) : null
        }
        <button type="submit" class="s-btn s-btn-p" style="width: 100%"
          >{create ? ui.signIn.createAccount : ui.signIn.emailMeACode}</button
        >
        <p style="margin: 0; font-size: 14px; color: #3E3B35"
          >{create ? page.createNote : page.signInNote}</p
        >
      </form>
    </div>
  </div>
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-block="auth"] [data-href]')) {
    btn.addEventListener('click', () => {
      const href = btn.getAttribute('data-href');
      if (href) location.assign(href);
    });
  }
</script>
