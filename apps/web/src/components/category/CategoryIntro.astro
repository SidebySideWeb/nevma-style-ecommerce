---
import type { CategoryPageData } from '../../lib/category';
import { ui } from '../../content/ui';

interface Props {
  page: CategoryPageData;
}

const { page: p } = Astro.props;
/** Long display names overflow the 2-col intro beside the body copy — stack instead. */
const stackIntro = p.name.replace(/\s/g, '').length > 5;
const introWrapStyle = stackIntro
  ? 'padding-block: 48px 40px; display: flex; flex-direction: column; gap: 28px'
  : 'padding-block: 48px 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 28px 80px; align-items: end';
---

<section aria-labelledby="cat-title" data-block="category-intro">
  <div class="s-wrap" style={introWrapStyle}>
    <div style="display: flex; flex-direction: column; gap: 22px">
      <p class="s-eb">{p.eyebrow}</p>
      <h1
        id="cat-title"
        class="s-disp"
        style="margin: 0; font-size: clamp(48px, 8vw, 128px); letter-spacing: 0.1em; line-height: 0.95"
        >{p.name}</h1
      >
      <span class="s-rule" aria-hidden="true" style="width: 120px"></span>
    </div>
    <p style="margin: 0; max-width: 46ch; font-size: 18px; color: #3E3B35">{p.intro}</p>
  </div>
  <div class="s-wrap" style="padding-bottom: 40px">
    <div
      role="group"
      aria-label={ui.category.categories}
      style="display: flex; gap: 8px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid #CFC7B8"
    >
      {
        p.chips.map((c) => (
          <button
            type="button"
            class="s-chip"
            aria-pressed={c.current ? 'true' : 'false'}
            data-href={c.href}
            data-category-chip
          >
            {c.name} <span style="opacity: 0.65">{c.count}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-category-chip]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const href = btn.dataset.href;
      if (href && href !== location.pathname) location.assign(href);
    });
  });
</script>
